menu "BLE Component"

config BUILD_COMPONENT_BLUETOOTH
	bool "NETWORK BLUETOOTH"
	default 0
	help
	  apply network BLUETOOTH component.

config BUILD_COMPONENT_BLUETOOTH_HCI_BRIDGE
	depends on BUILD_COMPONENT_BLUETOOTH
	bool "NETWORK BLUETOOTH HIC BRIDGE"
	default 1

config BUILD_COMPONENT_BLUETOOTH_LE_HOST
	depends on BUILD_COMPONENT_BLUETOOTH
	bool "NETWORK BLUETOOTH LE HOST"
	default 0

if BUILD_COMPONENT_BLUETOOTH_LE_HOST
config SUPPORT_PAWR
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	int "SUPPORT PAWR"
	default 0
	range 0 1
endif

config BUILD_COMPONENT_BLUETOOTH_LE_MESH
	depends on BUILD_COMPONENT_BLUETOOTH
	bool "NETWORK BLUETOOTH LE MESH"
	default 0

if BUILD_COMPONENT_BLUETOOTH_LE_MESH
config SUPPORT_MESH_SERVER
	depends on BUILD_COMPONENT_BLUETOOTH
	bool "SUPPORT BLE MESH SERVER"
	default 0

config SUPPORT_MESH_CLIENT
	depends on BUILD_COMPONENT_BLUETOOTH
	bool "SUPPORT BLE MESH CLIENT"
	default 0
endif

if BUILD_COMPONENT_BLUETOOTH_LE_HOST
menu "SELECT SUPPORT BLE SERVICES"
config BLUETOOTH_LE_SERVICE_GAP
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
