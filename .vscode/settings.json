{
  // common setting
  "editor.formatOnSave": true,
  "C_Cpp.clang_format_path": "D:/rafael_tool/llvm-mingw-x86_64/bin/clang-format.exe",
  "C_Cpp.formatting": "clangFormat",
  // Cortex-Debug common
  "cortex-debug.armToolchainPath.windows": "${workspaceFolder}/toolchain/arm/Windows/bin",
  "cortex-debug.armToolchainPath.linux": "${workspaceFolder}/toolchain/arm/Linux/bin",
  "cortex-debug.openocdPath.windows": "${workspaceFolder}/tools/Debugger/OpenOCD/bin/win/openocd.exe",
  "cortex-debug.openocdPath.linux": "${workspaceFolder}/tools/Debugger/OpenOCD/bin/linux/openocd",
  "cortex-debug.openocdPath.osx": "${workspaceFolder}/tools/Debugger/OpenOCD/bin/osx/openocd",
  "debug.enableDebugHover": false,
  "editor.hover.enabled": "off",
  "showDevDebugOutput": "raw",
  // Debug for RT584
  "cmake.debugConfig.RT58x": {
    "MIMode": "gdb",
    "name": "Cortex Debug (RT58x)",
    "executable": "${command:cmake.launchTargetPath}",
    "request": "launch",
    "type": "cortex-debug",
    "runToEntryPoint": "main",
    "servertype": "openocd",
    "configFiles": [
      "${workspaceFolder}/tools/Debugger/OpenOCD/script/interface/cmsis-dap.cfg",
      "${workspaceFolder}/tools/Debugger/OpenOCD/script/target/@MY_CHIP@.cfg"
    ],
    "searchDir": [
      "${workspaceFolder}/tools/Debugger/OpenOCD/script"
    ]
  },
  // Debug for RT584
  "cmake.debugConfig.RT584": {
    "MIMode": "gdb",
    "name": "Cortex Debug (RT584)",
    "executable": "${command:cmake.launchTargetPath}",
    "request": "launch",
    "type": "cortex-debug",
    "runToEntryPoint": "main",
    "servertype": "openocd",
    "configFiles": [
      "${workspaceFolder}/tools/Debugger/OpenOCD/script/interface/cmsis-dap.cfg",
      "${workspaceFolder}/tools/Debugger/OpenOCD/script/target/@MY_CHIP@.cfg"
    ],
    "searchDir": [
      "${workspaceFolder}/tools/Debugger/OpenOCD/script"
    ]
  },
