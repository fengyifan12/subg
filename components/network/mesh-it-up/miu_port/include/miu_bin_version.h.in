#ifndef __APP_BIN_VERSION_H
#define __APP_BIN_VERSION_H

#ifdef __cplusplus
extern "C" {
#endif
#include <stdint.h>

#define PREFIX_LEN  7
#define FW_INFO_LEN 16

typedef struct {
    uint8_t prefix[PREFIX_LEN];
    uint8_t sysinfo[FW_INFO_LEN];
    uint8_t feature_list;
} sys_information_t;

#define BUILD_VERSION_BYTE0 ((0x@BUILD_TIME_4BYTE@ >> 24) & 0xFF)
#define BUILD_VERSION_BYTE1 ((0x@BUILD_TIME_4BYTE@ >> 16) & 0xFF)
#define BUILD_VERSION_BYTE2 ((0x@BUILD_TIME_4BYTE@ >> 8) & 0xFF)
#define BUILD_VERSION_BYTE3 (0x@BUILD_TIME_4BYTE@ & 0xFF)

#define GIT_COMMIT_HASH_STR    "@GIT_COMMIT_HASH@"
#define OT_PACKAGE_VERSION_STR "@OT_PACKAGE_VERSION@"
// =======================================================

#define SYSTEMINFO_INIT(BIN_TYPE_ARR)                                          \
    {"VerGet",                                                                 \
     {(uint8_t)BUILD_VERSION_BYTE0, (uint8_t)BUILD_VERSION_BYTE1,              \
      (uint8_t)BUILD_VERSION_BYTE2, (uint8_t)BUILD_VERSION_BYTE3,              \
      BIN_TYPE_ARR},                                                           \
     0x1}

#define GET_BIN_VERSION(sysinfo)                                               \
    (((uint32_t)(sysinfo)[0] << 24) | ((uint32_t)(sysinfo)[1] << 16)           \
     | ((uint32_t)(sysinfo)[2] << 8) | ((uint32_t)(sysinfo)[3]))

#define GET_BIN_TYPE_PTR(sysinfo) ((const uint8_t*)(&(sysinfo)[4]))

extern const sys_information_t systeminfo;

#ifdef __cplusplus
};
#endif
#endif