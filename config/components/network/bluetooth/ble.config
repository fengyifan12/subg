	default 0

config BLUETOOTH_LE_SERVICE_BLS
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE BLS"
	default 0

config BLUETOOTH_LE_SERVICE_FOTA
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE FOTA"
	default 0

config BLUETOOTH_LE_SERVICE_HID
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE HID"
	default 0

config BLUETOOTH_LE_SERVICE_HRS
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE HRS"
	default 0

config BLUETOOTH_LE_SERVICE_MESH
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE MESH"
	default 0

config BLUETOOTH_LE_SERVICE_TRSP
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE TRSP"
	default 0

config BLUETOOTH_LE_SERVICE_MATTER
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE MATTER"
	default 0

config BLUETOOTH_LE_SERVICE_ESLS
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE ESL"
	default 0

config BLUETOOTH_LE_SERVICE_OTS
	depends on BUILD_COMPONENT_BLUETOOTH_LE_HOST
	bool "BLUETOOTH LE SERVICE OTS"
	default 0

endmenu

menu "BLE MAX LINK NUM"
config BLE_SUPPORT_NUM_CONN_MAX
    int "Bluetooth LE MAX LINK NUM"
	def_int 1
    range 0 8
endmenu
endif # BUILD_COMPONENT_BLUETOOTH_LE_HOST

