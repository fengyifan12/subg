menu "PROJECT CONFIG"

config APP_TASK_STACK_SIZE
    int "Application task stack size"
    range 256 4096
    default 2048

config APP_TASK_PRIORITY
    int "Application task priority"
    range 10 30
    default 15

config RADAR_UART1_TX_PIN
    int "Radar sensor UART1 TX pin number"
    range 0 31
    default 28
    help
      GPIO pin used as UART1 TX to communicate with the radar sensor.
      Default 28 matches the RF1301-EVB header.

config RADAR_UART1_RX_PIN
    int "Radar sensor UART1 RX pin number"
    range 0 31
    default 29
    help
      GPIO pin used as UART1 RX to communicate with the radar sensor.
      Default 29 matches the RF1301-EVB header.

config RADAR_PRESENCE_GPIO_PIN
    int "Radar presence detect GPIO pin number"
    range 0 31
    default 30
    help
      GPIO pin used to detect radar presence output.
      High level reports presence=1, low level reports presence=0.

endmenu
